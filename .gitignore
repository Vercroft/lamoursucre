# L'AmourSucré - Git ignore
# Based on the official create-next-app template (Next.js 16),
# plus this repo’s editor and local-tooling conventions.
# https://github.com/vercel/next.js/tree/canary/packages/create-next-app/templates

# --- dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- testing ---
/coverage

# --- next.js ---
/.next/
/out/

# --- production ---
/build

# --- misc / OS ---
.DS_Store
Thumbs.db

# --- debug logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- env / secrets / keys (never push these) ---
# Ignore all env files; allow a committed example template if you add one later.
.env*
!.env.example
*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
*.kdbx
id_rsa
id_rsa.*
id_dsa
id_ecdsa
id_ed25519
*.ppk
credentials.json
*-credentials.json
service-account*.json
.secrets/
secrets/

# --- vercel ---
.vercel

# --- typescript ---
*.tsbuildinfo
next-env.d.ts

# --- editors / IDEs ---
.idea/
.vscode/

# --- caches ---
.turbo
